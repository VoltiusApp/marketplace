{
  "name": "voltius-plugin-s3-sync",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=browser --format=esm --external:react --external:react/jsx-runtime --external:react-dom --external:@iconify/react --external:@voltius/ui --external:@voltius/api --outfile=index.js",
    "typecheck": "tsc --noEmit",
    "check": "node ../scripts/check-externals.mjs index.js",
    "test": "vitest run",
    "test:minio": "bash test/with-minio.sh"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@voltius/plugin-types": "^0.34.0",
    "esbuild": "0.25.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "description": "Voltius marketplace plugin: encrypted vault sync through any S3-compatible bucket",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/VoltiusApp/marketplace.git", "directory": "s3-sync" }
}
