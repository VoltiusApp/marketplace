{
  "name": "voltius-plugin-disk-usage",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=browser --format=esm --external:react --external:react/jsx-runtime --external:react-dom --external:@iconify/react --external:@voltius/ui --external:@voltius/api --outfile=index.js",
    "typecheck": "tsc --noEmit",
    "check": "node ../../scripts/check-externals.mjs index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@voltius/plugin-types": "^0.76.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "description": "Voltius marketplace plugin: disk usage explorer for SSH hosts and this computer",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/VoltiusApp/marketplace.git", "directory": "plugins/disk-usage" }
}
